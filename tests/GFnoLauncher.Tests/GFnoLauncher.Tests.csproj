<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- GameItem uses WPF colour types, so the test project needs the desktop runtime. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>GFnoLauncher.Tests</AssemblyName>
    <RootNamespace>GFnoLauncher.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floating minor versions: the test packages are restored from NuGet at build
         time, so this stays compatible with whichever SDK the runner installs. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\GameLauncher.csproj" />
  </ItemGroup>

</Project>
