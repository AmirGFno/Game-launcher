<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <!-- FolderBrowserDialog (System.Windows.Forms) is used to pick the optional game cache folder. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GameLauncher</RootNamespace>
    <AssemblyName>GFnoLauncher</AssemblyName>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>GFno Launcher</Product>
    <Title>GFno Launcher</Title>
    <Description>A minimalist, PlayStation-5-style Windows game launcher.</Description>
    <Version>2.0.0</Version>
    <!-- Keep the assembly/manifest version in sync (app.manifest). -->
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Copyright>GFno</Copyright>
    <Company>GFno</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- Used to read the icon embedded in a game executable (System.Drawing.Icon). -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- Pure-managed image library: adds WebP decoding (and a fallback for any
         format WPF cannot read) on top of WPF's built-in PNG/JPEG/BMP/GIF/ICO.
         Deliberately pinned to 3.1.12: 3.2.0 is the first release that patches the
         published ImageSharp advisories, but it also introduces build-time license
         enforcement (build/SixLabors.ImageSharp.targets -> SixLabors_ValidateLicense,
         "No Six Labors license found ... please obtain a license from
         sixlabors.com/pricing/"), which this free project cannot satisfy. Upgrading
         requires a commercial Six Labors license; until then 3.1.12 stays. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- MainWindow.xaml references these with relative URIs ("Assets/icon.png").
         WPF resolves those against the XAML file's pack URI, i.e.
         pack://application:,,,/Assets/icon.png - so the files MUST be embedded as
         WPF resources. Left as None/Content (loose files next to the exe) the lookup
         fails at startup with:
           TypeConverterMarkupExtension ... InnerException: IOException:
           Cannot locate resource 'assets/icon.png'.
         The .ico stays a plain file on disk too, because Inno Setup and the
         ApplicationIcon compiler step read it from the project directory. -->
    <None Remove="Assets\icon.png;Assets\icon.ico" />
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the unit tests call the internal image-validation helper. -->
    <InternalsVisibleTo Include="GFnoLauncher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project file sits at the repository root, so the SDK's default
         **/*.cs glob also matches tests/GFnoLauncher.Tests/*.cs. The app project
         would then compile the unit-test sources and fail with CS0246 on
         "using Xunit;" (observed in CI: the Build step went red and the Test
         step was skipped). Keep the test project independent from the app. -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Resource Remove="tests\**" />
    <Page Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

</Project>
