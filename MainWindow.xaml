<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GFno Launcher"
        Width="1280" Height="800"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icon.ico"
        Background="#FF0B0E14"
        TextOptions.TextFormattingMode="Display">

    <Grid>

        <!-- ============ Dynamic background: cross-fade + slow Ken Burns zoom ============ -->
        <Image x:Name="BackgroundImage"
               Stretch="UniformToFill"
               Opacity="0"
               RenderTransformOrigin="0.5,0.5"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Image.RenderTransform>
            <Image.Triggers>
                <EventTrigger RoutedEvent="Image.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             From="1" To="1.08" Duration="0:0:28" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             From="1" To="1.08" Duration="0:0:28" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Image.Triggers>
        </Image>

        <!-- ============ Bottom-to-top readability gradient ============ -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#000B0E14" Offset="0" />
                    <GradientStop Color="#990B0E14" Offset="0.55" />
                    <GradientStop Color="#F50B0E14" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ============ Layout ============ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Header / custom title bar ============ -->
            <Grid Grid.Row="0"
                  Background="#1F000000"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="56,0,0,0">
                    <Image Source="Assets/icon.png" Width="22" Height="22"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="GFno Launcher"
                               FontSize="15" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                    <TextBlock Text="{Binding Games.Count, StringFormat='{}{0} game(s)'}"
                               FontSize="12" Foreground="#FF8FA0BC"
                               VerticalAlignment="Center" Margin="18,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Margin="0,0,24,0">
                    <Button Content="Add" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding AddGameCommand}" Margin="0,0,8,0" />
                    <Button Content="Edit" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding EditGameCommand}" Margin="0,0,8,0" />
                    <Button Content="Delete" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding DeleteGameCommand}" Margin="0,0,28,0" />

                    <Button Style="{StaticResource HeaderButtonStyle}" ToolTip="Minimize"
                            Click="MinimizeButton_Click">
                        <Path Data="M6,15 L20,15 L20,17 L6,17 Z" Stroke="White" StrokeThickness="1"
                              Width="26" Height="16" Stretch="Uniform" Fill="White" StrokeLineJoin="Miter" />
                    </Button>
                    <Button Style="{StaticResource HeaderButtonStyle}" ToolTip="Maximize"
                            Click="MaximizeButton_Click">
                        <Path x:Name="MaximizeIcon" Data="M6,6 H20 V20 H6 Z" Stroke="White"
                              StrokeThickness="1.6" Fill="Transparent"
                              Width="26" Height="26" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource HeaderButtonStyle}" ToolTip="Close"
                            Click="CloseButton_Click">
                        <Path Data="M7,7 L21,21 M21,7 L7,21" Stroke="White" StrokeThickness="1.6"
                              Width="26" Height="26" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ Main ============ -->
            <Grid Grid.Row="1" Margin="56,0,56,100">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="230" />
                </Grid.RowDefinitions>

                <!-- Empty state -->
                <Grid Grid.Row="0"
                      Visibility="{Binding HasGames, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="88" Height="88">
                            <Ellipse Stroke="#FF2D9CDB" StrokeThickness="2.5" Fill="Transparent" Opacity="0.75" />
                            <Path Data="M34,24 L64,44 L34,64 Z" Fill="#FF2D9CDB" />
                        </Grid>
                        <TextBlock Text="Your library is empty" FontSize="22" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,20,0,6" />
                        <TextBlock Text="Use the Add button to add your first game."
                                   FontSize="13" Foreground="#FFB8C4D8" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Title, just above the carousel -->
                <StackPanel x:Name="TitlePanel"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,22"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel.RenderTransform>
                        <TranslateTransform Y="14" />
                    </StackPanel.RenderTransform>
                    <TextBlock Text="{Binding SelectedGame.Title}"
                               FontSize="30" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="900" TextWrapping="Wrap">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="Black" Opacity="0.8" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding SelectedGame.LaunchTarget}"
                               FontSize="12" Foreground="#FFB8C4D8"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Margin="0,6,0,0" MaxWidth="820" TextWrapping="Wrap" />
                </StackPanel>

                <!-- ============ Carousel of game logos ============ -->
                <Grid Grid.Row="2" VerticalAlignment="Bottom">
                    <ListBox x:Name="GamesListBox"
                             ItemsSource="{Binding Games}"
                             SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             FocusVisualStyle="{x:Null}"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             PreviewMouseWheel="GamesListBox_PreviewMouseWheel">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Opacity" Value="0.45" />
                                <!-- The glow exists for every tile but stays invisible until selected. -->
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="28" ShadowDepth="0"
                                                          Color="#FF2D9CDB" Opacity="0" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                        <Trigger.EnterActions>
                                            <!-- Spring-like pop with a soft overshoot -->
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                     To="1.2" Duration="0:0:0.34">
                                                        <DoubleAnimation.EasingFunction>
                                                            <BackEase Amplitude="0.55" EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                     To="1.2" Duration="0:0:0.34">
                                                        <DoubleAnimation.EasingFunction>
                                                            <BackEase Amplitude="0.55" EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                            <!-- Subtle pulsing glow behind the selected logo -->
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                                                     From="0.25" To="0.7" Duration="0:0:1.6" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                     To="0.85" Duration="0:0:0.26">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                     To="0.85" Duration="0:0:0.26">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="150" Height="150" Margin="10,0"
                                      ToolTip="{Binding Title}"
                                      PreviewMouseLeftButtonDown="GameTile_PreviewMouseLeftButtonDown">
                                    <Border CornerRadius="16"
                                            Background="#1FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                            Padding="14">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <TranslateTransform Y="0" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#FF2D9CDB" />
                                                        <Setter Property="Background" Value="#33FFFFFF" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="22" ShadowDepth="0"
                                                                                  Color="#FF2D9CDB" Opacity="0.6" />
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                                                                     To="-6" Duration="0:0:0.18">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseOut" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                                                                     To="0" Duration="0:0:0.24">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseOut" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Image Source="{Binding LogoPath, Converter={StaticResource ImagePathConverter}}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Grid Width="64" Height="64"
                                                  Visibility="{Binding LogoPath, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                                                <Ellipse Stroke="#FF3A4763" StrokeThickness="2" Fill="Transparent" />
                                                <Path Data="M26,18 L50,32 L26,46 Z" Fill="#FF3A4763" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============ Fade-out shadow along the very bottom edge ============ -->
        <Rectangle VerticalAlignment="Bottom" Height="150" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="0.55" />
                    <GradientStop Color="#F50B0E14" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ============ Hint ============ -->
        <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,34"
                   Text="Enter / Double-click — Launch      Scroll — Browse"
                   FontSize="12" Foreground="#FF9FB0CC" IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="Black" Opacity="0.7" />
            </TextBlock.Effect>
        </TextBlock>

        <!-- ============ Loading overlay (temp cleanup / launch) ============ -->
        <Grid Background="#CC000000"
              Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="Spinner"
                         Width="80" Height="80"
                         Stroke="#FF2D9CDB" StrokeThickness="6"
                         StrokeDashArray="5 7"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="20" Foreground="White" HorizontalAlignment="Center"
                           Margin="0,28,0,0" />
                <TextBlock Text="This can take a few seconds the first time."
                           FontSize="13" Foreground="#FFB8C4D8" HorizontalAlignment="Center"
                           Margin="0,10,0,0" />

                <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding CancelCommand}"
                        Width="120" Margin="0,28,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
