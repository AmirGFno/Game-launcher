<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GFno Launcher"
        Width="1440" Height="900"
        MinWidth="1024" MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0B0F17"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Auto">

    <!--
      Borderless window with a real WindowChrome: the caption buttons are drawn by
      React, but minimise / maximise / restore / snap / resize / DPI handling all
      stay native because WindowChrome implements them.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="#0B0F17">
        <!--
          The WebView2 control IS the application. It is loaded from a local virtual
          host (https://app.gfno.local) that maps to the packaged Vite build, so the
          released app never talks to localhost or a dev server.
        -->
        <wv2:WebView2 x:Name="WebView"
                      DefaultBackgroundColor="#0B0F17" />

        <!--
          Native fallback shown while WebView2 starts, or when it cannot start at
          all. A blank window with no explanation is never acceptable.
        -->
        <Grid x:Name="Overlay"
              Background="#0B0F17"
              Visibility="Visible">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="620">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image Grid.Row="0"
                       Source="Assets/icon.png"
                       Width="88" Height="88"
                       Margin="0,0,0,22" />

                <TextBlock Grid.Row="1"
                           x:Name="OverlayTitle"
                           Text="GFno Launcher"
                           Foreground="#F2F5FA"
                           FontSize="26"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />

                <TextBlock Grid.Row="2"
                           x:Name="OverlayMessage"
                           Text="Starting the interface..."
                           Foreground="#9AA6B8"
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,10,0,0" />

                <ProgressBar Grid.Row="3"
                             x:Name="OverlayProgress"
                             IsIndeterminate="True"
                             Height="3"
                             Margin="0,26,0,0"
                             Background="#1B2434"
                             Foreground="#00D1B2" />

                <Button Grid.Row="4"
                        x:Name="OverlayAction"
                        Content="Open the Microsoft WebView2 download page"
                        Visibility="Collapsed"
                        Margin="0,26,0,0"
                        Padding="16,9"
                        Background="#132030"
                        Foreground="#E6F7F4"
                        BorderBrush="#00D1B2"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
