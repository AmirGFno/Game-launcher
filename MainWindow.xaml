<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Launcher"
        Width="1280" Height="800"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF0B0E14"
        TextOptions.TextFormattingMode="Display">

    <Grid>

        <!-- Default backdrop gradient (visible while no background image is set) -->
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                    <GradientStop Color="#FF0B0E14" Offset="0" />
                    <GradientStop Color="#FF141B2D" Offset="0.55" />
                    <GradientStop Color="#FF0B0E14" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <!-- Dynamic background image of the selected game (faded in/out) -->
        <Image x:Name="BackgroundImage"
               Stretch="UniformToFill"
               Opacity="0"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <!-- Readability gradient so text stays legible over any artwork -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F20B0E14" Offset="0" />
                    <GradientStop Color="#990B0E14" Offset="0.45" />
                    <GradientStop Color="#F20B0E14" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Header / custom title bar ============ -->
            <Grid Grid.Row="0"
                  Background="#26000000"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="56,0,0,0">
                    <Border Width="9" Height="26" Background="#FF2D9CDB" CornerRadius="2" />
                    <TextBlock Text="GAME LAUNCHER"
                               FontSize="17" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" Margin="16,0,0,0" />
                    <TextBlock Text="{Binding Games.Count, StringFormat='{}{0} game(s)'}"
                               FontSize="13" Foreground="#FF8FA0BC"
                               VerticalAlignment="Center" Margin="18,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Margin="0,0,24,0">
                    <Button Content="Add" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding AddGameCommand}" Margin="0,0,8,0" />
                    <Button Content="Edit" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding EditGameCommand}" Margin="0,0,8,0" />
                    <Button Content="Delete" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding DeleteGameCommand}" Margin="0,0,28,0" />

                    <Button Style="{StaticResource HeaderButtonStyle}" ToolTip="Minimize"
                            Click="MinimizeButton_Click">
                        <Path Data="M6,15 L20,15 L20,17 L6,17 Z" Stroke="White" StrokeThickness="1"
                              Width="26" Height="16" Stretch="Uniform" Fill="White" StrokeLineJoin="Miter" />
                    </Button>
                    <Button Style="{StaticResource HeaderButtonStyle}" ToolTip="Maximize"
                            Click="MaximizeButton_Click">
                        <Path x:Name="MaximizeIcon" Data="M6,6 H20 V20 H6 Z" Stroke="White"
                              StrokeThickness="1.6" Fill="Transparent"
                              Width="26" Height="26" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource HeaderButtonStyle}" ToolTip="Close"
                            Click="CloseButton_Click">
                        <Path Data="M7,7 L21,21 M21,7 L7,21" Stroke="White" StrokeThickness="1.6"
                              Width="26" Height="26" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ Body ============ -->
            <Grid Grid.Row="1" Margin="56,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="300" />
                </Grid.RowDefinitions>

                <!-- Selected game + Play -->
                <Grid Grid.Row="0"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding SelectedGame.Title}"
                                   FontSize="58" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="1000"
                                   TextWrapping="Wrap">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="26" ShadowDepth="0" Color="Black" Opacity="0.85" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedGame.LaunchTarget}"
                                   FontSize="15" Foreground="#FFB8C4D8"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,10,0,0" MaxWidth="900" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedGame.LastPlayed, StringFormat='Last played: {0:g}'}"
                                   FontSize="12" Foreground="#FF7C8AA5"
                                   HorizontalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Row="2" Style="{StaticResource PlayButtonStyle}"
                            Command="{Binding PlayCommand}"
                            Margin="0,30,0,0" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#9654;" FontSize="20" VerticalAlignment="Center" Margin="0,2,14,0" />
                            <TextBlock Text="PLAY" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Empty state -->
                <Grid Grid.Row="0"
                      Visibility="{Binding HasGames, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="100" Height="100">
                            <Ellipse Stroke="#FF2D9CDB" StrokeThickness="3" Fill="Transparent" Opacity="0.8" />
                            <Path Data="M40,28 L74,50 L40,72 Z" Fill="#FF2D9CDB" />
                        </Grid>
                        <TextBlock Text="Your library is empty" FontSize="28" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,22,0,8" />
                        <TextBlock Text="Use the Add button to add your first game."
                                   FontSize="15" Foreground="#FFB8C4D8" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ============ Carousel of game logos ============ -->
                <Grid Grid.Row="1" VerticalAlignment="Bottom">
                    <ListBox x:Name="GamesListBox"
                             ItemsSource="{Binding Games}"
                             SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             FocusVisualStyle="{x:Null}"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             PreviewMouseWheel="GamesListBox_PreviewMouseWheel">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                     To="1.2" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                     To="1.2" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                     To="0.8" Duration="0:0:0.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                     To="0.8" Duration="0:0:0.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="150" Height="150" Margin="10,0" ToolTip="{Binding Title}">
                                    <Border CornerRadius="14"
                                            Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                            Padding="14">
                                        <Image Source="{Binding LogoPath, Converter={StaticResource ImagePathConverter}}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <Grid Width="64" Height="64"
                                          Visibility="{Binding LogoPath, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                                        <Ellipse Stroke="#FF3A4763" StrokeThickness="2" Fill="Transparent" />
                                        <Path Data="M26,18 L50,32 L26,46 Z" Fill="#FF3A4763" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="&#8592;  &#8594;  to browse"
                               FontSize="12" Foreground="#FF7C8AA5"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,4,2" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ============ Loading overlay (temp cleanup / launch) ============ -->
        <Grid Background="#CC000000"
              Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="Spinner"
                         Width="80" Height="80"
                         Stroke="#FF2D9CDB" StrokeThickness="6"
                         StrokeDashArray="5 7"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="20" Foreground="White" HorizontalAlignment="Center"
                           Margin="0,28,0,0" />
                <TextBlock Text="This can take a few seconds the first time."
                           FontSize="13" Foreground="#FFB8C4D8" HorizontalAlignment="Center"
                           Margin="0,10,0,0" />

                <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding CancelCommand}"
                        Width="120" Margin="0,28,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
