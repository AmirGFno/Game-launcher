<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameLauncher.Controls"
        Title="GFno Launcher"
        Width="1280" Height="800"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icon.ico"
        Background="#FF0B0E14"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Slow Ken Burns zoom, applied to both cross-fading background layers. -->
        <Style x:Key="KenBurnsImageStyle" TargetType="Image">
            <Setter Property="Stretch" Value="UniformToFill" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Image.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             From="1" To="1.08" Duration="0:0:28" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             From="1" To="1.08" Duration="0:0:28" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!--
        Explicit layering. Panel.ZIndex is set on every layer, so the wallpaper can
        never climb above the UI (the cross-fade below keeps its layers at 1 and 2,
        strictly below the overlay at 3 and the UI at 4).
          0 = default dark gradient background
          1 = background image (fading out)
          2 = background image (fading in, Ken Burns)
          3 = dark readability gradient overlay
          4 = all UI (header, title, carousel)
          5 = bottom vignette
          6 = floating action buttons / hint
          7 = loading overlay
    -->
    <Grid>

        <!-- ============ Layer 0: default dark gradient background ============ -->
        <Rectangle Panel.ZIndex="0">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF0B0E14" Offset="0" />
                    <GradientStop Color="#FF060910" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ============ Layers 1-2: dynamic background, cross-fading ============ -->
        <Image x:Name="BackgroundBack" Style="{StaticResource KenBurnsImageStyle}"
               Opacity="1" Panel.ZIndex="1" />
        <Image x:Name="BackgroundFront" Style="{StaticResource KenBurnsImageStyle}"
               Opacity="0" Panel.ZIndex="2" />

        <!-- ============ Layer 3: bottom-to-top readability gradient (kept light so
             the wallpaper stays visible) ============ -->
        <Rectangle Panel.ZIndex="3">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#000B0E14" Offset="0" />
                    <GradientStop Color="#330B0E14" Offset="0.55" />
                    <GradientStop Color="#990B0E14" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ============ Layer 4: all UI ============ -->
        <Grid Panel.ZIndex="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Header / custom title bar: cinematic fade, no glass ============ -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#990B0E14" Offset="0" />
                        <GradientStop Color="#000B0E14" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="48,0,0,0">
                    <Image Source="Assets/icon.png" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="GFno Launcher"
                               FontSize="14" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding Games.Count, StringFormat='{}{0} game(s)'}"
                               FontSize="12" Foreground="#FF8FA0BC"
                               VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>

                <!-- Add (left of the window controls) + Min / Max / Close -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Margin="0,0,20,0">
                    <Button Style="{StaticResource ActionButtonStyle}" ToolTip="Add game"
                            Command="{Binding AddGameCommand}" Margin="0,0,20,0">
                        <Path Data="M7,3 H9 V7 H13 V9 H9 V13 H7 V9 H3 V7 H7 Z" Fill="#FFFFFFFF"
                              Width="16" Height="16" Stretch="Uniform" IsHitTestVisible="False" />
                    </Button>
                    <Button Style="{StaticResource ChromeButtonStyle}" ToolTip="Minimize"
                            Click="MinimizeButton_Click">
                        <Path Data="M3,12.5 H13" Stroke="White" StrokeThickness="1.2"
                              Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ChromeButtonStyle}" ToolTip="Maximize"
                            Click="MaximizeButton_Click">
                        <Path x:Name="MaximizeIcon" Data="M3,3 H13 V13 H3 Z" Stroke="White"
                              StrokeThickness="1.2" Fill="Transparent"
                              Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ChromeButtonStyle}" ToolTip="Close"
                            Click="CloseButton_Click">
                        <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="White" StrokeThickness="1.2"
                              Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ Main ============ -->
            <Grid Grid.Row="1" Margin="56,0,56,100">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="230" />
                </Grid.RowDefinitions>

                <!-- Empty state -->
                <Grid Grid.Row="0"
                      Visibility="{Binding HasGames, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="84" Height="84">
                            <Ellipse Stroke="#FF2D9CDB" StrokeThickness="2.5" Fill="Transparent" Opacity="0.75" />
                            <Path Data="M42,28 V56 M28,42 H56" Stroke="#FF2D9CDB" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <TextBlock Text="Your library is empty" FontSize="20" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,20,0,6" />
                        <TextBlock Text="Use the + button to add your first game."
                                   FontSize="13" Foreground="#FFB8C4D8" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Title, right above the carousel -->
                <StackPanel x:Name="TitlePanel"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,4"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel.RenderTransform>
                        <TranslateTransform Y="14" />
                    </StackPanel.RenderTransform>
                    <TextBlock Text="{Binding SelectedGame.Title}"
                               FontSize="22" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="900" TextWrapping="Wrap">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="Black" Opacity="0.8" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- ============ Carousel of game logos ============ -->
                <Grid Grid.Row="2" VerticalAlignment="Bottom">
                    <ListBox x:Name="GamesListBox"
                             ItemsSource="{Binding Games}"
                             SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             FocusVisualStyle="{x:Null}"
                             ClipToBounds="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             PreviewMouseWheel="GamesListBox_PreviewMouseWheel">

                        <!-- ScrollViewer must not clip the scaled-up selected tile. -->
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}"
                                        ClipToBounds="False">
                                    <ScrollViewer ClipToBounds="False"
                                                  Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </ControlTemplate>
                        </ListBox.Template>

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            ClipToBounds="False" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <!-- Vertical room so the 1.2x scale is never clipped by the viewport. -->
                                <Setter Property="Margin" Value="0,30,0,30" />
                                <Setter Property="ClipToBounds" Value="False" />
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Opacity" Value="0.6" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <!-- Render above the neighbours instead of being cut off. -->
                                        <Setter Property="Panel.ZIndex" Value="1" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Trigger.EnterActions>
                                            <!-- Smooth spring-like scale up -->
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                     To="1.2" Duration="0:0:0.32">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                     To="1.2" Duration="0:0:0.32">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                     To="0.8" Duration="0:0:0.26">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                     To="0.8" Duration="0:0:0.26">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Raw image, no border / box. Rounded through Image.Clip. -->
                                <Grid Width="120" Height="120" Margin="10,0"
                                      ClipToBounds="False"
                                      ToolTip="{Binding Title}"
                                      PreviewMouseLeftButtonDown="GameTile_PreviewMouseLeftButtonDown">
                                    <controls:AsyncImage Style="{StaticResource CarouselImageStyle}"
                                                         Path="{Binding LogoPath}"
                                                         MaxWidth="256"
                                                         ClipToBounds="False">
                                        <controls:AsyncImage.Clip>
                                            <RectangleGeometry Rect="0,0,120,120" RadiusX="12" RadiusY="12" />
                                        </controls:AsyncImage.Clip>
                                        <!-- Soft glow tinted with the logo's dominant colour
                                             (ImageColorExtractor); pulses while selected. -->
                                        <controls:AsyncImage.Effect>
                                            <DropShadowEffect BlurRadius="28" ShadowDepth="0"
                                                              Color="{Binding LogoPath, Converter={StaticResource DominantColorConverter}}"
                                                              Opacity="0" />
                                        </controls:AsyncImage.Effect>
                                    </controls:AsyncImage>

                                    <!-- Fallback glyph when the game has no logo -->
                                    <Grid Width="56" Height="56"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding LogoPath, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                                        <Ellipse Stroke="#FF3A4763" StrokeThickness="2" Fill="Transparent" />
                                        <Path Data="M22,16 L40,28 L22,40 Z" Fill="#FF3A4763" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============ Layer 5: light fade-out along the very bottom edge ============ -->
        <Rectangle VerticalAlignment="Bottom" Height="150" IsHitTestVisible="False"
                   Panel.ZIndex="5">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#000B0E14" Offset="0" />
                    <GradientStop Color="#000B0E14" Offset="0.55" />
                    <GradientStop Color="#8C0B0E14" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ============ Layer 6: bottom-right actions: Reorder / Edit / Delete ============ -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,28,28" Panel.ZIndex="6">
            <Button Style="{StaticResource ReorderButtonStyle}" ToolTip="Reorder mode"
                    Command="{Binding ToggleReorderCommand}" Margin="0,0,10,0">
                <Path Data="M2,5 H11 M8,2 L11,5 L8,8 M14,11 H3 M6,8 L3,11 L6,14"
                      Stroke="#FFFFFFFF" StrokeThickness="1.2" Fill="Transparent"
                      Width="16" Height="16" Stretch="Uniform" IsHitTestVisible="False" />
            </Button>
            <Button Style="{StaticResource ActionButtonStyle}" ToolTip="Edit selected game"
                    Command="{Binding EditGameCommand}" Margin="0,0,10,0">
                <Path Data="M2,11.5 V14 H4.5 L11.87,6.63 L9.37,4.13 Z M13.8,4.69 C14.06,4.43 14.06,4.01 13.8,3.75 L12.24,2.19 C11.98,1.93 11.56,1.93 11.3,2.19 L10.08,3.41 L12.58,5.91 Z"
                      Fill="#FFFFFFFF" Width="16" Height="16" Stretch="Uniform" IsHitTestVisible="False" />
            </Button>
            <Button Style="{StaticResource ActionButtonStyle}" ToolTip="Delete selected game"
                    Command="{Binding DeleteGameCommand}">
                <Path Data="M4,12.7 C4,13.4 4.6,14 5.3,14 H10.7 C11.4,14 12,13.4 12,12.7 V4.7 H4 Z M12.7,2.7 H10.3 L9.7,2 H6.3 L5.7,2.7 H3.3 V4 H12.7 Z"
                      Fill="#FFFFFFFF" Width="16" Height="16" Stretch="Uniform" IsHitTestVisible="False" />
            </Button>
        </StackPanel>

        <!-- ============ Hint ============ -->
        <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,34"
                   Panel.ZIndex="6"
                   Text="{Binding ReorderHint}"
                   FontSize="12" Foreground="#FF9FB0CC" IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="Black" Opacity="0.7" />
            </TextBlock.Effect>
        </TextBlock>

        <!-- ============ Layer 7: loading overlay (temp cleanup / launch) ============ -->
        <Grid Background="#CC000000" Panel.ZIndex="7"
              Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="Spinner"
                         Width="80" Height="80"
                         Stroke="#FF2D9CDB" StrokeThickness="6"
                         StrokeDashArray="5 7"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="20" Foreground="White" HorizontalAlignment="Center"
                           Margin="0,28,0,0" />
                <TextBlock Text="This can take a few seconds the first time."
                           FontSize="13" Foreground="#FFB8C4D8" HorizontalAlignment="Center"
                           Margin="0,10,0,0" />

                <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding CancelCommand}"
                        Width="120" Margin="0,28,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
