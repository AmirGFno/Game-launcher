<Window x:Class="GameLauncher.Views.GameEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="780" Height="600"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF12161F"
        Foreground="White"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding WindowTitle}" FontSize="26" FontWeight="SemiBold" />

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="132" />
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Game Title *" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldTextBoxStyle}" />

            <!-- Launch target -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Launch Target *" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0" />
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding LaunchTarget, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldTextBoxStyle}" Margin="0,16,0,0" />
            <Button Grid.Row="1" Grid.Column="2" Content="Browse"
                    Style="{StaticResource GhostButtonStyle}" Command="{Binding BrowseLaunchTargetCommand}"
                    Width="82" Margin="10,16,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                       Text="An .exe path or a Steam URL, e.g. steam://rungameid/12345 &#x2014; picking an .exe fills in its name and icon automatically"
                       FontSize="11" Foreground="#FF7C8AA5" Margin="0,60,0,0" TextWrapping="Wrap" />

            <!-- Logo -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Logo Image" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0" />
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldTextBoxStyle}" Margin="0,16,0,0" />
            <Button Grid.Row="2" Grid.Column="2" Content="Browse"
                    Style="{StaticResource GhostButtonStyle}" Command="{Binding BrowseLogoCommand}"
                    Width="82" Margin="10,16,0,0" />
            <Button Grid.Row="2" Grid.Column="3" Content="Download"
                    ToolTip="Download the image from the URL in the field"
                    Style="{StaticResource GhostButtonStyle}" Command="{Binding DownloadLogoCommand}"
                    Width="122" Margin="10,16,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                       Text="Paste a direct image URL and press Download, or Browse for a local file (.ico, .png, .jpg, .webp)"
                       FontSize="11" Foreground="#FF7C8AA5" Margin="0,60,0,0" TextWrapping="Wrap" />

            <!-- Background -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Background Image" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0" />
            <TextBox Grid.Row="3" Grid.Column="1"
                     Text="{Binding BackgroundPath, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldTextBoxStyle}" Margin="0,16,0,0" />
            <Button Grid.Row="3" Grid.Column="2" Content="Browse"
                    Style="{StaticResource GhostButtonStyle}" Command="{Binding BrowseBackgroundCommand}"
                    Width="82" Margin="10,16,0,0" />
            <Button Grid.Row="3" Grid.Column="3" Content="Download"
                    ToolTip="Download the image from the URL in the field"
                    Style="{StaticResource GhostButtonStyle}" Command="{Binding DownloadBackgroundCommand}"
                    Width="122" Margin="10,16,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                       Text="Paste a direct image URL and press Download, or Browse for a local file (.png, .jpg, .webp)"
                       FontSize="11" Foreground="#FF7C8AA5" Margin="0,60,0,0" TextWrapping="Wrap" />

            <!-- Custom cache folder -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Custom Game Cache Folder" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0" />
            <TextBox Grid.Row="4" Grid.Column="1"
                     Text="{Binding CustomCacheFolderPath, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldTextBoxStyle}" Margin="0,16,0,0" />
            <Button Grid.Row="4" Grid.Column="2" Content="Browse"
                    Style="{StaticResource GhostButtonStyle}" Command="{Binding BrowseCacheFolderCommand}"
                    Width="82" Margin="10,16,0,0" />
            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                       Text="Legacy setting - kept for compatibility only. It is never deleted automatically; use the cache button to clean the app's own cache."
                       FontSize="11" Foreground="#FF7C8AA5" Margin="0,60,0,0" />
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Error}" FontSize="13" Foreground="#FFFF6B6B"
                   VerticalAlignment="Center" TextWrapping="Wrap" MinHeight="20" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}"
                    Command="{Binding CancelCommand}" Width="110" Margin="0,0,12,0" />
            <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}" Width="130" />
        </StackPanel>
    </Grid>
</Window>
