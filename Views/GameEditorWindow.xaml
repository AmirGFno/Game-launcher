<Window x:Class="GameLauncher.Views.GameEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GameLauncher.Controls" Title="{Binding WindowTitle}" Icon="/Assets/icon.ico" Width="860" Height="800" MinWidth="700" MinHeight="540" WindowStartupLocation="CenterOwner" Background="#0C1320" Foreground="#EDF2FA" FontFamily="Segoe UI">
 <Window.Resources><ResourceDictionary Source="MenuStyles.xaml"/></Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,22"><TextBlock Text="{Binding WindowTitle}" FontFamily="Segoe UI Semibold" FontSize="28"/><TextBlock Text="Your game, your artwork. Changes apply only when you save." Style="{StaticResource MenuHelp}"/></StackPanel>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
 <Border Style="{StaticResource MenuCard}"><StackPanel><TextBlock Text="GAME DETAILS" Style="{StaticResource MenuSection}"/><TextBlock Text="Game title" Margin="0,0,0,8"/><TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MenuField}"/>
 <TextBlock Text="Launch target" Margin="0,18,0,8"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseLaunchTargetCommand}" Style="{StaticResource MenuButton}" Margin="12,0,0,0"/><TextBox Text="{Binding LaunchTarget, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MenuField}"/></DockPanel><TextBlock Text="Choose an executable, or use steam://rungameid/12345. Executable metadata fills empty fields automatically." Style="{StaticResource MenuHelp}"/></StackPanel></Border>
 <Border Style="{StaticResource MenuCard}"><StackPanel><TextBlock Text="LOGO" Style="{StaticResource MenuSection}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#0C1320" CornerRadius="8" Margin="0,0,18,0"><controls:AsyncImage Path="{Binding LogoPath}" DecodeWidth="480" Width="130" Height="105" Stretch="Uniform"/></Border><StackPanel Grid.Column="1"><TextBox Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MenuField}"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Browse…" Command="{Binding BrowseLogoCommand}" Style="{StaticResource MenuButton}" Margin="0,0,10,0"/><Button Content="Download URL" Command="{Binding DownloadLogoCommand}" Style="{StaticResource MenuButton}"/></StackPanel><TextBlock Text="PNG, JPG, ICO or WebP. Paste a direct image URL, then Download URL." Style="{StaticResource MenuHelp}"/></StackPanel></Grid></StackPanel></Border>
 <Border Style="{StaticResource MenuCard}"><StackPanel><TextBlock Text="BACKGROUND" Style="{StaticResource MenuSection}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#0C1320" CornerRadius="8" Margin="0,0,18,0"><controls:AsyncImage Path="{Binding BackgroundPath}" DecodeWidth="480" Width="130" Height="105" Stretch="Uniform"/></Border><StackPanel Grid.Column="1"><TextBox Text="{Binding BackgroundPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MenuField}"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Browse…" Command="{Binding BrowseBackgroundCommand}" Style="{StaticResource MenuButton}" Margin="0,0,10,0"/><Button Content="Download URL" Command="{Binding DownloadBackgroundCommand}" Style="{StaticResource MenuButton}"/></StackPanel><TextBlock Text="PNG, JPG, ICO or WebP. Paste a direct image URL, then Download URL." Style="{StaticResource MenuHelp}"/></StackPanel></Grid></StackPanel></Border>
 <Border Style="{StaticResource MenuCard}"><StackPanel><TextBlock Text="COMPATIBILITY" Style="{StaticResource MenuSection}"/><TextBlock Text="Legacy game cache folder" Margin="0,0,0,8"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCacheFolderCommand}" Style="{StaticResource MenuButton}" Margin="12,0,0,0"/><TextBox Text="{Binding CustomCacheFolderPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MenuField}"/></DockPanel><TextBlock Text="Preserved for compatibility only. This folder is never automatically deleted." Style="{StaticResource MenuHelp}"/></StackPanel></Border>
 </StackPanel></ScrollViewer>
 <TextBlock Grid.Row="2" Text="{Binding Error}" TextWrapping="Wrap" Foreground="#D6B8BA" Margin="0,12,0,0"/>
 <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource MenuButton}" Margin="0,0,12,0"/><Button Content="Save game" Command="{Binding SaveCommand}" Style="{StaticResource MenuPrimary}"/></StackPanel>
 </Grid>
</Window>
