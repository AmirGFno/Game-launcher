<Window x:Class="GameLauncher.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings" Width="520" Height="540" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#10192B" Foreground="White">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="Your launcher" FontFamily="Segoe UI Semibold" FontSize="26" Margin="0,0,0,22"/>
 <TextBlock Text="CAROUSEL STYLE" Foreground="#72DECE" Margin="0,0,0,10"/>
 <RadioButton x:Name="Loop" Content="Loop (PS5 Style)" Foreground="White" GroupName="Style" Margin="0,0,0,10"/>
 <RadioButton x:Name="Anchor" Content="Fixed Anchor" Foreground="White" GroupName="Style" Margin="0,0,0,22"/>
 <CheckBox x:Name="Fullscreen" Content="Fullscreen — hide the top bar (F11 to toggle)" Foreground="White" Margin="0,0,0,18"/>
 <CheckBox x:Name="Cleanup" Content="Temp cleanup before launching" Foreground="White"/>
 <TextBlock Text="Only GFno's own cache. Windows Temp, games and personal folders are never cleaned." TextWrapping="Wrap" FontSize="12" Foreground="#9BAAC2" Margin="22,6,0,18"/>
 <CheckBox x:Name="Tray" Content="Close to Tray (unchecked: Quit on Close)" Foreground="White" Margin="0,0,0,20"/>
 <Button Content="Clear downloaded artwork…" Click="ClearArtwork_Click" Style="{StaticResource GhostButtonStyle}" Padding="14,8" HorizontalAlignment="Left"/>
 <TextBlock x:Name="Result" TextWrapping="Wrap" Foreground="#B9A8EF" Margin="0,10,0,0"/>
 </StackPanel>
 <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Padding="18,9" Margin="0,0,10,0"/><Button Content="Save settings" IsDefault="True" Click="Save_Click" Padding="18,9"/></StackPanel>
 </Grid>
</Window>
